# API base path or URL; VITE_API_BASE_URL takes precedence; legacy VITE_API_URL remains supported.
VITE_API_BASE_URL=http://localhost:8000/api
# Optional explicit OAuth redirect; normally derived from API base + /auth/google/redirect.
# VITE_GOOGLE_AUTH_URL=http://localhost:8000/api/auth/google/redirect

# Optional Laravel Reverb connection. The app still polls the API every 15 seconds as a fallback.
# App key is public; never expose REVERB_APP_SECRET in frontend environment variables.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
# Optional explicit URL if broadcasting auth is not at the API origin.
# VITE_REVERB_AUTH_URL=http://localhost:8000/broadcasting/auth
